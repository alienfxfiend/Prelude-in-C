/////////////////////////////////////////////////////////////////////////////
//
// Dialog
//

IDD_NEWGAMEDLG DIALOGEX 0, 0, 270, 350 //240,310
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "New Game Setup"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
LTEXT           "Game &Mode:", IDC_STATIC_GAMEMODE, 7, 7, 80, 8
COMBOBOX        IDC_COMBO_GAMEMODE, 7, 17, 115, 40, CBS_DROPDOWNLIST | CBS_HASSTRINGS | WS_VSCROLL | WS_TABSTOP
LTEXT           "Balls to Win:", IDC_STATIC_BALLS_WIN, 7, 35, 50, 8
EDITTEXT        IDC_EDIT_BALLS_WIN, 60, 33, 37, 12, ES_RIGHT | ES_AUTOHSCROLL | ES_NUMBER

// [+] FIX: Widened the GroupBox and Radio Buttons to prevent text cropping
GROUPBOX        "Player Type", IDC_STATIC, 7, 55, 115, 65
CONTROL         "&2 Player (Human vs Human)", IDC_RADIO_2P, "Button", BS_AUTORADIOBUTTON | WS_GROUP | WS_TABSTOP, 14, 68, 105, 10
CONTROL         "Human vs &CPU", IDC_RADIO_CPU, "Button", BS_AUTORADIOBUTTON | WS_TABSTOP, 14, 83, 105, 10
CONTROL         "&Network Play (Online)", IDC_RADIO_NETWORK, "Button", BS_AUTORADIOBUTTON | WS_TABSTOP, 14, 98, 105, 10

LTEXT           "Table Color:", IDC_STATIC, 7, 125, 50, 8
COMBOBOX        IDC_COMBO_TABLECOLOR, 7, 135, 115, 60, CBS_DROPDOWNLIST | CBS_HASSTRINGS | WS_VSCROLL | WS_TABSTOP
PUSHBUTTON      "Edit &Names...", IDC_BTN_EDITNAMES, 7, 160, 115, 14
PUSHBUTTON      "Configure &Network...", IDC_BTN_NETCONFIG, 7, 178, 115, 14

GROUPBOX        "Player Statistics", IDC_STATIC, 7, 200, 115, 65
LTEXT           "P1:", IDC_STATS_P1, 14, 212, 100, 8
LTEXT           "2P:", IDC_STATS_2P, 14, 224, 100, 8
LTEXT           "AI:", IDC_STATS_AI, 14, 236, 100, 8
PUSHBUTTON      "&Reset Scores", IDC_BTN_RESET_SCORES, 14, 248, 100, 10

GROUPBOX        "AI Difficulty", IDC_GROUP_AI, 130, 7, 123, 65
CONTROL         "&Easy", IDC_RADIO_EASY, "Button", BS_AUTORADIOBUTTON | WS_GROUP | WS_TABSTOP, 137, 20, 90, 10
CONTROL         "&Medium", IDC_RADIO_MEDIUM, "Button", BS_AUTORADIOBUTTON | WS_TABSTOP, 137, 35, 90, 10
CONTROL         "&Hard", IDC_RADIO_HARD, "Button", BS_AUTORADIOBUTTON | WS_TABSTOP, 137, 50, 90, 10
GROUPBOX        "Opening Break Modes:", IDC_GROUP_BREAK_MODE, 130, 80, 123, 65
CONTROL         "&CPU Break", IDC_RADIO_CPU_BREAK, "Button", BS_AUTORADIOBUTTON | WS_GROUP | WS_TABSTOP, 137, 93, 90, 10
CONTROL         "&P1 Break", IDC_RADIO_P1_BREAK, "Button", BS_AUTORADIOBUTTON | WS_TABSTOP, 137, 108, 90, 10
CONTROL         "&FlipCoin Break", IDC_RADIO_FLIP_BREAK, "Button", BS_AUTORADIOBUTTON | WS_TABSTOP, 137, 123, 90, 10
GROUPBOX        "Free Play / Auto", IDC_GROUP_FREE_PLAY, 130, 153, 123, 48
CONTROL         "&Practice Mode", IDC_CHECK_PRACTICE, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 137, 166, 90, 10
CONTROL         "&Demo Mode", IDC_CHECK_DEMO, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 137, 181, 90, 10

// [+] FIX: Widened Character Select Area to match new dialog width
GROUPBOX        "Character Select", IDC_GROUP_CHAR_SELECT, 7, 270, 246, 45
LTEXT           "P1:", IDC_STATIC, 14, 282, 12, 8
COMBOBOX        IDC_COMBO_P1_SPRITE, 28, 280, 45, 90, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
CONTROL         "", IDC_PIC_P1_SPRITE, "Static", SS_OWNERDRAW, 78, 279, 25, 18

LTEXT           "P2:", IDC_STATIC, 114, 282, 12, 8
COMBOBOX        IDC_COMBO_P2_SPRITE, 128, 280, 45, 90, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
CONTROL         "", IDC_PIC_P2_SPRITE, "Static", SS_OWNERDRAW, 178, 279, 25, 18

    // Shifted down
    DEFPUSHBUTTON   "Start", IDOK, 75, 325, 50, 14
    PUSHBUTTON      "Cancel", IDCANCEL, 135, 325, 50, 14

    // Permanent New Game dialog scrollbar.
    // This is intentionally a child SCROLLBAR control instead of WS_VSCROLL.
    // When scrolling is not needed, it remains visible but disabled.
    CONTROL         "", IDC_NEWGAME_VSCROLL, "ScrollBar", SBS_VERT | WS_VISIBLE | WS_DISABLED, 258, 0, 12, 350
END

IDD_ABOUTBOX DIALOGEX 0, 0, 429, 211
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "About"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
DEFPUSHBUTTON   "OK", IDOK, 372, 190, 50, 14
CTEXT           "CodeBreakers", IDC_STATIC, 5, 22, 133, 10
CONTROL         "", IDC_HACKER_PIC, "Static", SS_BITMAP, 23, 34, 133, 110
CONTROL         "", IDC_CAPTBOAT_PIC, "Static", SS_BITMAP, 173, 136, 133, 40
CTEXT           "tiny.cc/mathcore", IDC_LINK_MATHCORE, 9, 188, 133, 12, SS_NOTIFY
LTEXT           "", IDC_ABOUT_TEXT, 165, 20, 245, 107
END


IDD_EDITNAMESDLG DIALOGEX 0, 0, 200, 140
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Edit Player Names"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
LTEXT           "Human Player 1:", IDC_STATIC, 7, 10, 70, 8
EDITTEXT        IDC_EDIT_P1_NAME, 80, 7, 110, 14, ES_AUTOHSCROLL
LTEXT           "Human Player 2:", IDC_STATIC, 7, 30, 70, 8
EDITTEXT        IDC_EDIT_P2_NAME, 80, 27, 110, 14, ES_AUTOHSCROLL
LTEXT           "CPU Player 1:", IDC_STATIC, 7, 50, 70, 8
EDITTEXT        IDC_EDIT_AI1_NAME, 80, 47, 110, 14, ES_AUTOHSCROLL
LTEXT           "CPU Player 2:", IDC_STATIC, 7, 70, 70, 8
EDITTEXT        IDC_EDIT_AI_NAME, 80, 67, 110, 14, ES_AUTOHSCROLL
DEFPUSHBUTTON   "OK", IDOK, 45, 115, 50, 14
PUSHBUTTON      "Cancel", IDCANCEL, 105, 115, 50, 14
END


IDD_NETWORKDLG DIALOGEX 0, 0, 230, 195
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Network Game Setup"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
GROUPBOX        "Connection Type", IDC_STATIC, 7, 7, 216, 40
CONTROL         "&Host Game (Listen for connections)", IDC_RADIO_NET_HOST, "Button", BS_AUTORADIOBUTTON | WS_GROUP | WS_TABSTOP, 14, 20, 160, 10
CONTROL         "&Connect to Remote Game", IDC_RADIO_NET_CLIENT, "Button", BS_AUTORADIOBUTTON | WS_TABSTOP, 14, 33, 160, 10

LTEXT           "Remote IP Address:", IDC_STATIC, 7, 55, 80, 8
EDITTEXT        IDC_EDIT_NET_IP, 95, 53, 120, 14, ES_AUTOHSCROLL

LTEXT           "Port:", IDC_STATIC, 7, 75, 30, 8
EDITTEXT        IDC_EDIT_NET_PORT, 95, 73, 50, 14, ES_AUTOHSCROLL | ES_NUMBER

LTEXT           "Password:", IDC_STATIC, 7, 95, 40, 8
EDITTEXT        IDC_EDIT_NET_PASSWORD, 95, 93, 120, 14, ES_AUTOHSCROLL | ES_PASSWORD

PUSHBUTTON      "&Start / Connect", IDC_BTN_NET_CONNECT, 7, 115, 90, 16
LTEXT           "Status: Not connected", IDC_STATIC_NET_STATUS, 7, 138, 216, 40

DEFPUSHBUTTON   "OK", IDOK, 55, 178, 50, 14
PUSHBUTTON      "Cancel", IDCANCEL, 120, 178, 50, 14
END


